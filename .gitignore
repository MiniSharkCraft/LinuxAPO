# Build trees and CMake-generated state
/build*/
/cmake-build-*/
/_build/
/out/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
/Testing/
_CPack_Packages/

# Compiled outputs, coverage and crash/debug artifacts
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe
*.pdb
*.gcda
*.gcno
*.profraw
*.profdata
core
core.*
*.core

# Local package staging and generated release archives
/packaging/skyapo/
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*
/packaging/*.deb
/packaging/*.rpm
/packaging/*.tar.zst
/release-artifacts/
/*.pkg.tar.*
/*.deb
/*.rpm
/*.tar.zst

# Local recordings, test output, logs and temporary/editor files
*.wav
/test-output/
/test-results/
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]

# Local credentials and environment files (keep shareable examples possible)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json

# Local plugin drops and compatibility prefixes; never bundle user content
/plugins/
/user-plugins/
/vst/
/vst2/
/vst3/
/clap/
/lv2/
/.wine/
/wineprefix*/
/yabridge-*/

# Agent/worktree scratch directories
/.worktrees/
/worktrees/
