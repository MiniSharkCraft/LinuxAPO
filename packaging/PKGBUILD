pkgname=skyapo
pkgver=0.1.0
pkgrel=8
pkgdesc='Linux audio processing port based on Equalizer APO DSP'
# Maintainer: Cong Nguyen
arch=('x86_64')
license=('GPL-2.0-or-later' 'MIT')
depends=('pipewire' 'libsndfile' 'fftw' 'lilv' 'qt6-base' 'hicolor-icon-theme' 'muparser')
makedepends=('cmake' 'gcc' 'git' 'pkgconf')
# Makepkg runs this PKGBUILD from its containing directory. Using PWD avoids
# namcap treating the sibling checkout as a package install-time dependency.
source=("skyapo::git+file://${PWD}/..")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/skyapo"
  git submodule update --init --recursive
}

build() {
  cmake -S "$srcdir/skyapo" -B "$srcdir/skyapo-build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build "$srcdir/skyapo-build" --parallel
}

check() {
  ctest --test-dir "$srcdir/skyapo-build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/skyapo-build"

  # Arch and namcap expect the license texts under /usr/share/licenses/$pkgname.
  # Keep the copies under the project documentation as well, then install the
  # same upstream texts into the standard package license directory.
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  install -m 644 "$pkgdir/usr/share/doc/SkyAPO/licenses/"*.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
