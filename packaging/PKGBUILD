pkgname=skyapo
pkgver=0.9.0
pkgrel=1
pkgdesc='Linux audio processing port based on Equalizer APO DSP'
# Maintainer: Cong Nguyen
arch=('x86_64')
license=('GPL-2.0-or-later' 'LGPL-3.0-only' 'MIT' 'BSD-2-Clause')
depends=('pipewire' 'libsndfile' 'fftw' 'lilv' 'qt6-base' 'hicolor-icon-theme')
makedepends=('cmake' 'gcc' 'git' 'pkgconf')
# Makepkg runs this PKGBUILD from its containing directory. Using PWD avoids
# namcap treating the sibling checkout as a package install-time dependency.
source=("skyapo::git+file://${PWD}/.."
        'muparserx_v3_0_1.zip::https://sourceforge.net/p/equalizerapo/wiki/Developer%20documentation/attachment/muparserx_v3_0_1.zip')
sha256sums=('SKIP'
            '11689042843844638414af070f928ef5200461dc59fa237bad4a01531f982609')

# `git+file://` checks out committed Git state; it does not snapshot the
# developer's modified or untracked files. Refuse a misleading package build
# instead of silently packaging a different tree than the one being reviewed.
_skyapo_source_root="$(realpath "${PWD}/..")"

prepare() {
  if [[ -n "$(git -C "$_skyapo_source_root" status --porcelain --untracked-files=all)" ]]; then
    printf '==> ERROR: SkyAPO source worktree is dirty; commit or stash changes before makepkg.\n' >&2
    printf '==> ERROR: The local git+file source only includes committed files.\n' >&2
    return 1
  fi

  cd "$srcdir/skyapo"
  local expected_revision checked_out_revision
  expected_revision="$(git -C "$_skyapo_source_root" rev-parse HEAD)"
  checked_out_revision="$(git -C "$srcdir/skyapo" rev-parse HEAD)"
  if [[ "$checked_out_revision" != "$expected_revision" ]]; then
    printf '==> Updating cached source checkout %s -> %s\n' \
      "$checked_out_revision" "$expected_revision"
    git -C "$srcdir/skyapo" fetch --quiet "$_skyapo_source_root" \
      "$expected_revision"
    git -C "$srcdir/skyapo" checkout --detach "$expected_revision"
  fi
  git submodule update --init --recursive
}

build() {
  local jobs="${SKYAPO_BUILD_JOBS:-2}"
  if [[ ! "$jobs" =~ ^[1-9][0-9]*$ ]]; then
    printf '==> ERROR: SKYAPO_BUILD_JOBS must be a positive integer (got %q).\n' "$jobs" >&2
    return 1
  fi

  cmake -S "$srcdir/skyapo" -B "$srcdir/skyapo-build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DSKYAPO_MUPARSERX_ARCHIVE="$srcdir/muparserx_v3_0_1.zip"
  cmake --build "$srcdir/skyapo-build" --parallel "$jobs"
}

check() {
  ctest --test-dir "$srcdir/skyapo-build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/skyapo-build"

  # Arch and namcap expect the license texts under /usr/share/licenses/$pkgname.
  # Keep the copies under the project documentation as well, then install the
  # same upstream texts into the standard package license directory.
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  install -m 644 "$pkgdir/usr/share/doc/SkyAPO/licenses/"*.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname"

  python "$srcdir/skyapo/packaging/package_smoke_test.py" "$pkgdir"
}
