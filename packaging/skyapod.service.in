[Unit]
Description=SkyAPO Equalizer APO audio processing daemon
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_BINDIR@/skyapod
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=default.target
